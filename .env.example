# ResearchLoop configuration — copy to .env and fill in. No secrets in the repo.

# LLM layer (OpenAI-compatible endpoint; works with OpenAI, Groq, OpenRouter, etc.)
# Without these, the app runs in LABELLED mock mode (MockLLM) so the demo never breaks.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Adaption integration (Adaptive Data — invent/improve)
# ADAPTION_MODE=real uses the Adaption API; emulated runs a documented local emulation.
ADAPTION_API_BASE=
ADAPTION_API_KEY=
ADAPTION_MODE=emulated

# Session data directory
SESSION_DIR=data/sessions
